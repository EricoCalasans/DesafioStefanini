{
  "name": "@coe/orders-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "pretest": "npm run build",
    "test": "vitest run --exclude '**/integration/**'",
    "pretest:integration": "npm run build && node scripts/run-test-migrations.mjs",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "db:migrate": "npm run build && node dist/migrations/run.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test scripts vitest.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@nestjs/testing": "12.2.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
